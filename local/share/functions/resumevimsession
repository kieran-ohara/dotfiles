resumevimsession() {
  emulate -L zsh

  local HOST_MOUNT="${HOME}/src/$1"
  local FILENAME="${HOST_MOUNT}/Session.vim"
  local COMMAND

  if [ -f "$FILENAME" ]; then
      COMMAND="nvim -S $FILENAME"
  else
      cd "${HOST_MOUNT}" || return 1
      COMMAND="nvim -c ':Obsess'"
  fi
  $SHELL -c "$COMMAND"
}
