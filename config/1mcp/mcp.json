{
  "mcpServers": {
    "browserbase": {
      "command": "mcp-remote",
      "args": ["https://mcp.browserbase.com/mcp?browserbaseApiKey=${BROWSERBASE_API_KEY}"],
      "tags": ["core"]
    },
    "playwright": {
      "command": "playwright-mcp",
      "args": [],
      "tags": ["core"]
    },
    "obsidian": {
      "command": "mcp-obsidian",
      "args": ["${HOME}/Obsidian/Vault"],
      "tags": ["core"]
    },
    "mochi": {
      "command": "mcp-mochi",
      "args": [],
      "env": {
        "MOCHI_API_KEY": "${MOCHI_API_KEY}"
      },
      "tags": ["core"]
    },
    "xero": {
      "command": "xero-mcp-server",
      "args": [],
      "env": {
        "XERO_CLIENT_ID": "${XERO_CLIENT_ID}",
        "XERO_CLIENT_SECRET": "${XERO_CLIENT_SECRET}"
      },
      "tags": ["accounting"]
    },
    "context7": {
      "command": "mcp-remote",
      "args": ["https://mcp.context7.com/mcp", "--header", "CONTEXT7_API_KEY:${MCP_CONTEXT7_API_KEY}"],
      "tags": ["dev"]
    },
    "aws-knowledge": {
      "command": "mcp-remote",
      "args": ["https://knowledge-mcp.global.api.aws"],
      "tags": ["dev"]
    },
    "granola": {
      "command": "mcp-remote",
      "args": ["https://mcp.granola.ai/mcp"],
      "tags": ["core"]
    },
    "miro": {
      "command": "mcp-remote",
      "args": ["https://mcp.miro.com/mcp"],
      "tags": ["core"]
    },
    "omnifocus": {
      "command": "omnifocus-mcp",
      "args": [],
      "tags": ["core"]
    },
    "langfuse": {
      "command": "mcp-remote",
      "args": ["https://cloud.langfuse.com/api/public/mcp", "--header", "Authorization:${LANGFUSE_MCP_AUTH}"],
      "tags": ["dev"]
    },
    "1password": {
      "command": "/Applications/1Password.app/Contents/MacOS/onepassword-mcp",
      "args": [],
      "tags": ["dev"]
    },
    "next-devtools": {
      "command": "next-devtools-mcp",
      "args": [],
      "tags": ["dev"]
    },
    "v0": {
      "command": "mcp-remote",
      "args": ["https://v0.app/api/mcp"],
      "tags": ["dev"]
    },
    "mobbin": {
      "command": "mcp-remote",
      "args": ["https://api.mobbin.com/mcp"],
      "tags": ["dev"]
    }
  }
}
